# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Acceso de administrador central (servidor) ---
# Genera el hash con:  npm run admin:hash -- "tu clave de al menos 10 caracteres"
# Sin ADMIN_PIN_HASH el acceso de administrador central queda desactivado.
ADMIN_USERNAME="admin"
ADMIN_PIN_HASH=""

# Solo desarrollo: habilita vendedores de demostración (PIN 1234). Se ignora en producción.
# ALLOW_DEMO_LOGINS="true"

# Si el servidor está detrás de un proxy (Render, Railway, Nginx...): número de saltos.
# TRUST_PROXY="1"

# --- Base de datos de contenido (Supabase): leaks, catalogo, vendedores, pagos y archivos ---
# Todo lo que empiece con VITE_ viaja al navegador: aqui va SOLO la clave publica (anon / publishable).
# NUNCA pongas aqui la service_role ni una clave "secret". Guia paso a paso: supabase/LEEME.md
# Con estas dos variables el panel (#ironcat) usa correo + contrasena de Supabase Authentication.
# VITE_CONTENT_SUPABASE_URL="https://xxxxxxxx.supabase.co"
# VITE_CONTENT_SUPABASE_ANON_KEY="clave-publica"
