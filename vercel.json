{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --legacy-peer-deps",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/imagenes/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "X-DP-Env",
          "value": "staging"
        },
        {
          "key": "X-DP-Data-Source",
          "value": "https://mgoufbntqyksunablrzb.supabase.co"
        }
      ]
    },
    {
      "source": "/config.json",
      "headers": [
        {
          "key": "X-DP-Env",
          "value": "staging"
        },
        {
          "key": "X-DP-Data-Source",
          "value": "https://mgoufbntqyksunablrzb.supabase.co"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
